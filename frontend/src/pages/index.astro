---
/**
 * pages/index.astro — Landing pública
 *
 * Hero, features, pricing CTA, contacto.
 * BaseLayout directo (sin sidebar).
 */
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
import { actions, isInputError } from "astro:actions";
import Icon from "@ui/Icon.astro";

const result = Astro.getActionResult(actions.landing.contact);
const inputErrors = result && isInputError(result.error) ? result.error.fields : {};
---

<BaseLayout title="Rehalo — Sistema para clínicas de fisioterapia">
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-accent/40 via-background to-background"></div>
    <div class="container mx-auto px-6 py-20 md:py-28">
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-muted-foreground">
          <Icon name="sparkles" class="size-3" />
          Beta con IA clínica · Solicita acceso anticipado
        </span>
        <h1 class="mt-6 text-balance text-4xl font-bold tracking-tight md:text-6xl">
          Menos documentación.
          <span class="text-primary">Más rehabilitación.</span>
        </h1>
        <p class="mt-6 text-balance text-lg text-muted-foreground md:text-xl">
          Rehalo es el sistema operativo para clínicas de fisioterapia: agenda,
          historia clínica, planes de tratamiento, facturación y un copiloto de IA
          que redacta tus notas SOAP mientras atendés.
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href="/register"
            class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/90"
          >
            Solicitar acceso
          </a>
          <a
            href="/features"
            class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-background px-6 text-sm font-medium transition-colors hover:bg-accent"
          >
            Ver funcionalidades
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="border-t border-border bg-muted/30 py-20">
    <div class="container mx-auto px-6">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight md:text-4xl">
          Todo lo que tu clínica necesita
        </h2>
        <p class="mt-4 text-muted-foreground">
          Diseñado por fisioterapeutas, para fisioterapeutas.
        </p>
      </div>

      <div class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {[
          { icon: "calendar-event", title: "Agenda inteligente", desc: "Multi-terapeuta, multi-sala, lista de espera automática y recordatorios por WhatsApp." },
          { icon: "clipboard-list", title: "Notas SOAP con IA", desc: "Dictá la sesión y el copiloto estructura la nota y sugiere códigos CPT." },
          { icon: "barbell", title: "Planes HEP", desc: "Biblioteca de ejercicios y adherencia monitoreada por el agente de seguimiento." },
          { icon: "receipt", title: "Facturación a seguros", desc: "Códigos CPT/ICD, claims automáticos y conciliación de cuentas." },
          { icon: "chart-line", title: "Analítica clínica", desc: "Comparativa sesión a sesión, alertas de falta de progreso y predicción de abandono." },
          { icon: "shield-lock", title: "Cumplimiento normativo", desc: "HL7 FHIR, cifrado AES-256, auditoría y bitácora de accesos listos para HIPAA/RGPD." },
        ].map((f) => (
          <div class="rounded-lg border border-border bg-card p-6 transition-colors hover:border-primary/50">
            <div class="flex size-10 items-center justify-center rounded-md bg-primary/10 text-primary">
              <Icon name={f.icon} class="size-5" />
            </div>
            <h3 class="mt-4 text-lg font-semibold">{f.title}</h3>
            <p class="mt-2 text-sm text-muted-foreground">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="py-20">
    <div class="container mx-auto px-6">
      <div class="mx-auto max-w-xl">
        <h2 class="text-3xl font-bold tracking-tight">Hablemos</h2>
        <p class="mt-2 text-muted-foreground">
          ¿Sos dueño de una clínica o un centro de rehabilitación? Coordinamos un demo.
        </p>

        {result?.data?.ok && (
          <div class="mt-6 rounded-md border border-primary/20 bg-accent p-4 text-sm text-accent-foreground">
            ¡Gracias! Te contactaremos en menos de 24h.
          </div>
        )}
        {result?.error && !isInputError(result.error) && (
          <div class="mt-6 rounded-md border border-destructive/20 bg-destructive/10 p-4 text-sm text-destructive">
            {result.error.message}
          </div>
        )}

        <form method="POST" action={actions.landing.contact} class="mt-8 space-y-4">
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class="text-sm font-medium" for="name">Nombre</label>
              <input
                id="name"
                name="name"
                required
                class="mt-1 block w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/20"
              />
              {inputErrors?.name && <p class="mt-1 text-xs text-destructive">{inputErrors.name[0]}</p>}
            </div>
            <div>
              <label class="text-sm font-medium" for="email">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                class="mt-1 block w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/20"
              />
              {inputErrors?.email && <p class="mt-1 text-xs text-destructive">{inputErrors.email[0]}</p>}
            </div>
          </div>
          <div>
            <label class="text-sm font-medium" for="clinicName">Clínica</label>
            <input
              id="clinicName"
              name="clinicName"
              class="mt-1 block w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/20"
            />
          </div>
          <div>
            <label class="text-sm font-medium" for="message">Mensaje</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              class="mt-1 block w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/20"
            ></textarea>
            {inputErrors?.message && <p class="mt-1 text-xs text-destructive">{inputErrors.message[0]}</p>}
          </div>
          <button
            type="submit"
            class="inline-flex h-11 w-full items-center justify-center rounded-md bg-primary px-6 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90"
          >
            Enviar mensaje
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
