---
/**
 * pages/dashboard/reports.astro
 *
 * Vista de reportes con métricas clínicas reales. Los gráficos se montan
 * como island de React (Recharts) sobre el shell Astro.
 *
 * Spec 1 — Reportería clínica.
 */
import AdminLayout from "@layouts/AdminLayout.astro";
import ReportsCharts from "@islands/ReportsCharts";
import {
  getReportKpis,
  getClinicalAlerts,
  getEvaByPatient,
} from "@lib/mock/reports";

const kpis = getReportKpis();
const alerts = getClinicalAlerts();
const highPain = getEvaByPatient().filter((p) => p.eva >= 7);
---

<AdminLayout title="Reportes — Rehalo">
  <!-- Header -->
  <header class="mb-6 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-3xl font-bold tracking-tight">Reportes clínicos</h1>
      <p class="mt-1 text-sm text-muted-foreground">
        Métricas en tiempo real · actualizadas al {new Date().toLocaleString("es-AR", { day: "2-digit", month: "long", year: "numeric", hour: "2-digit", minute: "2-digit" })}
      </p>
    </div>
    <div class="flex gap-2">
      <button
        type="button"
        class="inline-flex h-10 items-center gap-2 rounded-lg border border-border bg-card px-3 text-sm font-medium hover:bg-accent"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Exportar PDF
      </button>
      <button
        type="button"
        class="inline-flex h-10 items-center gap-2 rounded-lg bg-primary px-3 text-sm font-semibold text-primary-foreground shadow-sm hover:bg-primary/90"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
        Período: Mes actual
      </button>
    </div>
  </header>

  <!-- KPIs resumen -->
  <section class="mb-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="surface-card p-5">
      <div class="flex items-center justify-between">
        <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Pacientes activos</p>
        <span class="rounded-full bg-primary/10 px-2 py-0.5 text-[10px] font-semibold text-primary">+12% mes</span>
      </div>
      <p class="mt-2 text-3xl font-bold tracking-tight">{kpis.activePatients}</p>
      <p class="mt-1 text-xs text-muted-foreground">en tratamiento</p>
    </div>
    <div class="surface-card p-5">
      <div class="flex items-center justify-between">
        <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Sesiones totales</p>
        <span class="rounded-full bg-info/10 px-2 py-0.5 text-[10px] font-semibold text-info">esta semana</span>
      </div>
      <p class="mt-2 text-3xl font-bold tracking-tight">{kpis.totalSessions}</p>
      <p class="mt-1 text-xs text-muted-foreground">programadas</p>
    </div>
    <div class="surface-card p-5">
      <div class="flex items-center justify-between">
        <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">EVA promedio</p>
        <span class={`rounded-full px-2 py-0.5 text-[10px] font-semibold ${kpis.avgEva >= 7 ? "bg-destructive/10 text-destructive" : kpis.avgEva >= 5 ? "bg-warning/10 text-warning" : "bg-success/10 text-success"}`}>
          {kpis.avgEva >= 7 ? "severo" : kpis.avgEva >= 5 ? "moderado" : "leve"}
        </span>
      </div>
      <p class="mt-2 text-3xl font-bold tracking-tight">{kpis.avgEva}<span class="text-base font-medium text-muted-foreground">/10</span></p>
      <p class="mt-1 text-xs text-muted-foreground">escala visual analógica</p>
    </div>
    <div class="surface-card p-5">
      <div class="flex items-center justify-between">
        <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Tasa no-show</p>
        <span class={`rounded-full px-2 py-0.5 text-[10px] font-semibold ${kpis.noShowRate > 10 ? "bg-destructive/10 text-destructive" : "bg-success/10 text-success"}`}>
          {kpis.noShowRate > 10 ? "por encima del objetivo" : "en objetivo"}
        </span>
      </div>
      <p class="mt-2 text-3xl font-bold tracking-tight">{kpis.noShowRate}<span class="text-base font-medium text-muted-foreground">%</span></p>
      <p class="mt-1 text-xs text-muted-foreground">objetivo ≤10%</p>
    </div>
  </section>

  <!-- Alertas prioritarias -->
  {alerts.length > 0 && (
    <section class="mb-6 surface-card border-warning/40 bg-warning/5 p-5">
      <div class="mb-2 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-warning" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <h2 class="text-base font-semibold">{highPain.length > 0 ? `${highPain.length} pacientes con dolor severo` : "Atención prioritaria requerida"}</h2>
      </div>
      <p class="text-sm text-muted-foreground">
        Pacientes con EVA ≥7/10 o sin consentimiento firmado. Considerar ajuste de plan
        o seguimiento estrecho.
      </p>
    </section>
  )}

  <!-- Island de React con todos los gráficos Recharts -->
  <ReportsCharts client:load />
</AdminLayout>
