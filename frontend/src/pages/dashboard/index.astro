---
/**
 * pages/dashboard/index.astro
 *
 * Vista general del panel administrativo.
 * KPIs principales: ocupación, ingresos, pacientes activos, próximas citas.
 */
import AdminLayout from "@layouts/AdminLayout.astro";
import Icon from "@ui/Icon.astro";

// TODO: sustituir por fetch al backend con api.get('/dashboard/kpis', { cookies: Astro.cookies })
const kpis = {
  ocupacion: 78,
  ingresosMes: 45230,
  pacientesActivos: 142,
  citasHoy: 18,
};

const proximasCitas = [
  { hora: "09:00", paciente: "Lucía Méndez", tipo: "Sesión seguimiento", box: "Box 2" },
  { hora: "10:30", paciente: "Carlos Pérez", tipo: "Evaluación inicial", box: "Box 1" },
  { hora: "11:00", paciente: "Marta Rivas", tipo: "Sesión seguimiento", box: "Box 3" },
  { hora: "12:30", paciente: "Diego Salazar", tipo: "Reevaluación", box: "Box 1" },
];
---

<AdminLayout title="Dashboard — Rehalo">
  <div slot="topbar">
    <div class="flex flex-1 items-center justify-between">
      <div>
        <h1 class="text-xl font-semibold tracking-tight">Buenos días</h1>
        <p class="text-sm text-muted-foreground">
          {new Date().toLocaleDateString("es", { weekday: "long", day: "numeric", month: "long" })}
        </p>
      </div>
      <a
        href="/dashboard/appointments/new"
        class="inline-flex h-9 items-center gap-2 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/90"
      >
        <Icon name="plus" class="size-4" /> Nueva cita
      </a>
    </div>
  </div>

  <!-- KPIs -->
  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
    {[
      { label: "Ocupación", value: `${kpis.ocupacion}%`, icon: "chart-pie", trend: "+5% vs semana anterior" },
      { label: "Ingresos del mes", value: `$${kpis.ingresosMes.toLocaleString()}`, icon: "currency-dollar", trend: "+12% vs mes anterior" },
      { label: "Pacientes activos", value: kpis.pacientesActivos, icon: "users", trend: "+8 este mes" },
      { label: "Citas hoy", value: kpis.citasHoy, icon: "calendar-event", trend: "6 completadas, 12 restantes" },
    ].map((kpi) => (
      <div class="rounded-lg border border-border bg-card p-5">
        <div class="flex items-center justify-between">
          <p class="text-sm font-medium text-muted-foreground">{kpi.label}</p>
          <Icon name={kpi.icon} class="size-4 text-muted-foreground" />
        </div>
        <p class="mt-2 text-3xl font-bold">{kpi.value}</p>
        <p class="mt-1 text-xs text-muted-foreground">{kpi.trend}</p>
      </div>
    ))}
  </div>

  <!-- Próximas citas + alertas -->
  <div class="mt-6 grid gap-6 lg:grid-cols-3">
    <div class="rounded-lg border border-border bg-card lg:col-span-2">
      <div class="flex items-center justify-between border-b border-border p-4">
        <h2 class="font-semibold">Próximas citas</h2>
        <a href="/dashboard/appointments" class="text-sm text-primary hover:underline">Ver todas</a>
      </div>
      <ul class="divide-y divide-border">
        {proximasCitas.map((c) => (
          <li class="flex items-center gap-4 p-4 hover:bg-accent/40">
            <span class="font-mono text-sm font-medium text-primary">{c.hora}</span>
            <div class="flex-1">
              <p class="font-medium">{c.paciente}</p>
              <p class="text-sm text-muted-foreground">{c.tipo}</p>
            </div>
            <span class="rounded-md bg-muted px-2 py-1 text-xs">{c.box}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="rounded-lg border border-border bg-card">
      <div class="border-b border-border p-4">
        <h2 class="font-semibold">Alertas clínicas</h2>
      </div>
      <ul class="divide-y divide-border">
        <li class="flex gap-3 p-4">
          <Icon name="alert-triangle" class="size-5 shrink-0 text-destructive" />
          <div class="text-sm">
            <p class="font-medium">3 pacientes con riesgo de abandono</p>
            <p class="text-muted-foreground">IA detectó patrones de baja adherencia</p>
          </div>
        </li>
        <li class="flex gap-3 p-4">
          <Icon name="clipboard-check" class="size-5 shrink-0 text-primary" />
          <div class="text-sm">
            <p class="font-medium">2 notas SOAP pendientes</p>
            <p class="text-muted-foreground">Firma de sesión requerida</p>
          </div>
        </li>
        <li class="flex gap-3 p-4">
          <Icon name="calendar-exclamation" class="size-5 shrink-0 text-amber-500" />
          <div class="text-sm">
            <p class="font-medium">Equipo requiere mantenimiento</p>
            <p class="text-muted-foreground">TENS unidad #3 — próximo 12/08</p>
          </div>
        </li>
      </ul>
    </div>
  </div>
</AdminLayout>
