---
/**
 * pages/dashboard/index.astro
 *
 * Vista general del panel administrativo.
 * KPIs principales: ocupación, ingresos, pacientes activos, próximas citas.
 *
 * Estilo ACRU: topbar fijo lo provee AdminLayout. Aquí empieza el contenido
 * de la página (greeting + KPIs + próximas citas + alertas).
 */
import AdminLayout from "@layouts/AdminLayout.astro";
import Icon from "@ui/Icon.astro";

// TODO: sustituir por fetch al backend con api.get('/dashboard/kpis', { cookies: Astro.cookies })
const kpis = {
  ocupacion: 78,
  ingresosMes: 45230,
  pacientesActivos: 142,
  citasHoy: 18,
};

const proximasCitas = [
  { hora: "09:00", paciente: "Lucía Méndez", tipo: "Sesión seguimiento", box: "Box 2" },
  { hora: "10:30", paciente: "Carlos Pérez", tipo: "Evaluación inicial", box: "Box 1" },
  { hora: "11:00", paciente: "Marta Rivas", tipo: "Sesión seguimiento", box: "Box 3" },
  { hora: "12:30", paciente: "Diego Salazar", tipo: "Reevaluación", box: "Box 1" },
];

const fechaCorta = new Date().toLocaleDateString("es", {
  weekday: "long",
  day: "numeric",
  month: "long",
});
const greeting =
  new Date().getHours() < 12
    ? "Buenos días"
    : new Date().getHours() < 19
      ? "Buenas tardes"
      : "Buenas noches";
---

<AdminLayout title="Dashboard — Rehalo">
  <!-- Greeting + acción principal -->
  <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold tracking-tight">{greeting}</h1>
      <p class="mt-1 text-sm capitalize text-muted-foreground">{fechaCorta}</p>
    </div>
    <a
      href="/dashboard/appointments/new"
      class="inline-flex h-10 items-center gap-2 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/85"
    >
      <Icon name="plus" class="size-4" />
      Nueva cita
    </a>
  </div>

  <!-- KPIs -->
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
    {[
      {
        label: "Ocupación",
        value: `${kpis.ocupacion}%`,
        icon: "chart-pie",
        trend: "+5% vs semana anterior",
        trendUp: true,
        highlight: true,
      },
      {
        label: "Ingresos del mes",
        value: `$${kpis.ingresosMes.toLocaleString("es")}`,
        icon: "currency-dollar",
        trend: "+12% vs mes anterior",
        trendUp: true,
      },
      {
        label: "Pacientes activos",
        value: kpis.pacientesActivos.toString(),
        icon: "users",
        trend: "+8 este mes",
        trendUp: true,
      },
      {
        label: "Citas hoy",
        value: kpis.citasHoy.toString(),
        icon: "calendar-event",
        trend: "6 completadas, 12 restantes",
        trendUp: true,
      },
    ].map((kpi) => (
      <div class="surface-card p-6 transition-shadow hover:shadow-token-md">
        <div class="flex items-center justify-between">
          <p class="text-sm font-medium text-muted-foreground">{kpi.label}</p>
          <Icon name={kpi.icon} class="size-4 text-muted-foreground" />
        </div>
        <p
          class:list={[
            "mt-3 kpi-display",
            kpi.highlight && "text-primary",
          ]}
        >
          {kpi.value}
        </p>
        <p class="mt-2 text-xs text-muted-foreground">{kpi.trend}</p>
      </div>
    ))}
  </div>

  <!-- Próximas citas + alertas -->
  <div class="mt-6 grid gap-6 lg:grid-cols-3">
    <div class="surface-card lg:col-span-2">
      <div class="flex items-center justify-between border-b border-border px-6 py-4">
        <h2 class="text-base font-semibold">Próximas citas</h2>
        <a
          href="/dashboard/appointments"
          class="text-sm text-primary hover:underline"
          >Ver todas</a
        >
      </div>
      <ul class="divide-y divide-border">
        {proximasCitas.map((c) => (
          <li class="flex items-center gap-4 px-6 py-4 transition-colors hover:bg-accent/40">
            <span class="font-mono text-sm font-semibold text-primary">
              {c.hora}
            </span>
            <div class="flex-1 min-w-0">
              <p class="truncate font-medium">{c.paciente}</p>
              <p class="truncate text-sm text-muted-foreground">{c.tipo}</p>
            </div>
            <span class="chip chip-neutral">{c.box}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="surface-card">
      <div class="border-b border-border px-6 py-4">
        <h2 class="text-base font-semibold">Alertas clínicas</h2>
      </div>
      <ul class="divide-y divide-border">
        <li class="flex gap-3 px-6 py-4">
          <Icon
            name="alert-triangle"
            class="size-5 shrink-0 text-destructive"
          />
          <div class="text-sm">
            <p class="font-medium">3 pacientes con riesgo de abandono</p>
            <p class="text-muted-foreground">
              IA detectó patrones de baja adherencia
            </p>
          </div>
        </li>
        <li class="flex gap-3 px-6 py-4">
          <Icon name="clipboard-check" class="size-5 shrink-0 text-primary" />
          <div class="text-sm">
            <p class="font-medium">2 notas SOAP pendientes</p>
            <p class="text-muted-foreground">Firma de sesión requerida</p>
          </div>
        </li>
        <li class="flex gap-3 px-6 py-4">
          <Icon
            name="calendar-exclamation"
            class="size-5 shrink-0 text-warning"
          />
          <div class="text-sm">
            <p class="font-medium">Equipo requiere mantenimiento</p>
            <p class="text-muted-foreground">
              TENS unidad #3 — próximo 12/08
            </p>
          </div>
        </li>
      </ul>
    </div>
  </div>
</AdminLayout>